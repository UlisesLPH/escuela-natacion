# Copia este archivo como .env y cambia los valores antes de usarlo en serio.
#   cp .env.example .env

# Puerto de tu equipo donde se abre la aplicación: http://localhost:8000
APP_PORT=8000

# Base de datos PostgreSQL (solo se usa dentro de Docker)
POSTGRES_DB=natacion
POSTGRES_USER=natacion
POSTGRES_PASSWORD=natacion

# Clave para firmar las sesiones. Pon un texto largo y aleatorio.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Administrador que se crea la primera vez que arranca la API
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Zona horaria (afecta el cálculo de "le toca pagar hoy")
TZ=America/Mexico_City
